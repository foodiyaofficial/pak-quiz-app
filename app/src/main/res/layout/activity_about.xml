<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/header_gradient"
        android:padding="18dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/about_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About the App"
                android:textColor="@color/accent_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_dark"
                android:text="PakQuiz is a free test-preparation app built for Pakistani students, covering 14 subjects including Islamic Studies, General Knowledge, Pakistan Studies, World Knowledge, Science, Physics, Chemistry, Biology, Nuclear Physics, Electronics, Computer Science, Logical Reasoning, English, and Mathematics \u2014 helpful for NTS, PPSC, FPSC/CSS, ISSB, and university entry tests. All quiz content is stored on your device and works without an internet connection; an internet connection is only used to display ads that keep the app free." />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/privacy_title"
                android:textColor="@color/accent_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_dark"
                android:text="PakQuiz does not require account sign-up and does not collect, store, or transmit any personal information to any server, because the quiz content itself has no backend and works fully offline. Quiz scores and your progress history are stored only in your device's local storage and are never uploaded anywhere.\n\nThis app displays advertisements via Google AdMob to support free access. AdMob may collect limited technical data (such as device identifiers) as described in Google's own privacy policy, in order to show relevant ads. Displaying ads requires an internet connection, but no quiz content, questions, or your personal answers are ever sent anywhere. This app itself does not access, read, or share your personal data, contacts, files, or location.\n\nFor questions, feedback, or to report an incorrect question, contact: askthebhai@gmail.com" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Version 1.0"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
