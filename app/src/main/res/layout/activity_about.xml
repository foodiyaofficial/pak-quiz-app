<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/header_gradient"
        android:padding="18dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/about_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About the App"
                android:textColor="@color/accent_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_dark"
                android:text="PakQuiz is a free, offline test-preparation app built for Pakistani students. It offers practice questions across Islamic Studies, General Knowledge, Science, Physics, Chemistry, Biology, English, and Mathematics \u2014 helpful for NTS, PPSC, FPSC/CSS, ISSB, and university entry tests. All content is stored on your device; the app works without an internet connection." />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/privacy_title"
                android:textColor="@color/accent_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_dark"
                android:text="PakQuiz does not require account sign-up and does not collect, store, or transmit any personal information to any server, because the app has no backend or internet connection for its core features. Quiz scores are stored only in your device's local storage and are never uploaded anywhere.\n\nIf this app displays advertisements (via Google AdMob), the ad network may collect limited technical data (such as device identifiers) as described in Google's own privacy policy, in order to show ads. This app itself does not access, read, or share your personal data, contacts, files, or location.\n\nFor questions about this privacy policy, please contact the developer through the app's Google Play Store listing page." />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Version 1.0"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
