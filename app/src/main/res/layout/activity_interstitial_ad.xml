<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:gravity="center"
    android:padding="24dp">

    <!-- This screen briefly appears while a real AdMob interstitial loads. If the ad loads
         successfully it takes over the full screen automatically. If it fails to load
         (offline, no fill, etc), this screen's Continue button is the safe fallback so
         the user is never stuck. -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Advertisement"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:letterSpacing="0.15" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Loading..."
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="If nothing appears in a few seconds, tap Continue below"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/continueButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Continue to Results"
        android:backgroundTint="@color/accent"
        android:textColor="@color/primary_dark" />

</LinearLayout>
